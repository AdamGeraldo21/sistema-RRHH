{
  "name": "talenta-rh-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Talenta RH (Express + PostgreSQL)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
