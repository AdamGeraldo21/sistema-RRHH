# Copia este archivo como .env para desarrollo local (npm run dev).

# Cadena de conexión de PostgreSQL. En Render usa la "Internal Database URL" para el
# Web Service, o la "External Database URL" para conectarte desde tu computadora.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos

# Secreto para firmar los tokens de sesión (cualquier texto largo y aleatorio).
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Orígenes permitidos (separados por coma).
CORS_ORIGIN=http://localhost:4200

PORT=3000
